    {
      "name": "Test di gestione errori",
      "item": [
        {
          "name": "400 - Dati cliente non validi",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"nome\":\"\",\"cognome\":\"Rossi\",\"email\":\"non-email\",\"dataRegistrazione\":null,\"concessionarioId\":0}" },
            "url": "{{baseUrl}}/api/clienti"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 400 Bad Request', function () { pm.response.to.have.status(400); });"] } }]
        },
        {
          "name": "404 - Cliente inesistente",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/clienti/999999" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 404 Not Found', function () { pm.response.to.have.status(404); });"] } }]
        },
        {
          "name": "404 - Concessionario associato inesistente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"nome\":\"Non valido\",\"cognome\":\"Test\",\"email\":\"missing-dealer@example.com\",\"dataRegistrazione\":\"2026-11-02\",\"concessionarioId\":999999}" },
            "url": "{{baseUrl}}/api/clienti"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 404 Not Found', function () { pm.response.to.have.status(404); });"] } }]
        },
        {
          "name": "409 - Email già presente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"nome\":\"Duplicato\",\"cognome\":\"Test\",\"email\":\"mario@email.it\",\"dataRegistrazione\":\"2026-11-02\",\"concessionarioId\":{{concessionarioId}}}" },
            "url": "{{baseUrl}}/api/clienti"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 409 Conflict', function () { pm.response.to.have.status(409); });"] } }]
        },
        {
          "name": "409 - Casa Madre con concessionari",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/case-madri/{{casaMadreId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 409 Conflict', function () { pm.response.to.have.status(409); });"] } }]
        },
        {
          "name": "409 - Concessionario con clienti",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/concessionari/{{concessionarioId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 409 Conflict', function () { pm.response.to.have.status(409); });"] } }]
        },
        {
          "name": "400 - Query parameter mancante",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/concessionari/fatturato?min=100000" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 400 Bad Request', function () { pm.response.to.have.status(400); });"] } }]
        }
      ]
    }
  ]

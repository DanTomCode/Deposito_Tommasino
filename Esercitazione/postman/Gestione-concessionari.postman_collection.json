{
  "info": {
    "_postman_id": "a9af16b8-3f18-47a2-983a-78e01426bce1",
    "name": "Gestione concessionari - esercitazione",
    "description": "Test CRUD, query Name Convention, JPQL, statistiche e gestione errori. Importare prima database/02-populate-data.sql per i test sulle query e sugli errori relazionali. Le richieste CRUD creano e poi cancellano record di test propri.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "casaMadreId", "value": "1" },
    { "key": "concessionarioId", "value": "1" },
    { "key": "clienteId", "value": "1" },
    { "key": "createdCasaMadreId", "value": "" },
    { "key": "createdConcessionarioId", "value": "" },
    { "key": "createdClienteId", "value": "" },
    { "key": "testEmail", "value": "postman-test@example.com" }
  ],
  "item": [
    {
      "name": "Casa Madri CRUD",
      "item": [
        {
          "name": "POST - Crea casa madre",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"ragioneSociale\":\"Postman Motors\",\"sedeLegale\":\"Roma\",\"paese\":\"Italia\",\"annoFondazione\":2000,\"fatturatoAnnuo\":1200000}" },
            "url": "{{baseUrl}}/api/case-madri"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 201 Created', function () { pm.response.to.have.status(201); });", "pm.collectionVariables.set('createdCasaMadreId', pm.response.json().id);"] } }]
        },
        {
          "name": "GET - Elenco case madri",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/case-madri" }
        },
        {
          "name": "GET - Casa madre per ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/case-madri/{{createdCasaMadreId}}" }
        },
        {
          "name": "PUT - Modifica casa madre",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"ragioneSociale\":\"Postman Motors Aggiornata\",\"sedeLegale\":\"Roma\",\"paese\":\"Italia\",\"annoFondazione\":2000,\"fatturatoAnnuo\":1500000}" },
            "url": "{{baseUrl}}/api/case-madri/{{createdCasaMadreId}}"
          }
        }
      ]
    },
    {
      "name": "Concessionari CRUD",
      "item": [
        {
          "name": "POST - Crea concessionario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"nome\":\"Postman Autos\",\"citta\":\"Roma\",\"indirizzo\":\"Via Roma 1\",\"telefono\":\"061234567\",\"fatturato\":220000,\"casaMadreId\":{{createdCasaMadreId}}}" },
            "url": "{{baseUrl}}/api/concessionari"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 201 Created', function () { pm.response.to.have.status(201); });", "pm.collectionVariables.set('createdConcessionarioId', pm.response.json().id);"] } }]
        },
        {
          "name": "GET - Elenco concessionari",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/concessionari" }
        },
        {
          "name": "GET - Concessionario per ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/concessionari/{{createdConcessionarioId}}" }
        },
        {
          "name": "PUT - Modifica concessionario",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"nome\":\"Postman Autos\",\"citta\":\"Milano\",\"indirizzo\":\"Via Roma 1\",\"telefono\":\"061234567\",\"fatturato\":240000,\"casaMadreId\":{{createdCasaMadreId}}}" },
            "url": "{{baseUrl}}/api/concessionari/{{createdConcessionarioId}}"
          }
        }
      ]
    },
    {
      "name": "Clienti CRUD",
      "item": [
        {
          "name": "POST - Crea cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"nome\":\"Postman\",\"cognome\":\"Tester\",\"email\":\"{{testEmail}}\",\"telefono\":\"3331234567\",\"dataRegistrazione\":\"2026-11-02\",\"concessionarioId\":{{createdConcessionarioId}}}" },
            "url": "{{baseUrl}}/api/clienti"
          },
          "event": [
            { "listen": "prerequest", "script": { "exec": ["pm.collectionVariables.set('testEmail', 'postman-' + Date.now() + '@example.com');"] } },
            { "listen": "test", "script": { "exec": ["pm.test('HTTP 201 Created', function () { pm.response.to.have.status(201); });", "pm.collectionVariables.set('createdClienteId', pm.response.json().id);"] } }
          ]
        },
        {
          "name": "GET - Elenco clienti",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/clienti" }
        },
        {
          "name": "GET - Cliente per ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/clienti/{{createdClienteId}}" }
        },
        {
          "name": "PUT - Modifica cliente",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"nome\":\"Postman\",\"cognome\":\"Tester Aggiornato\",\"email\":\"{{testEmail}}\",\"telefono\":\"3339876543\",\"dataRegistrazione\":\"2026-11-02\",\"concessionarioId\":{{createdConcessionarioId}}}" },
            "url": "{{baseUrl}}/api/clienti/{{createdClienteId}}"
          }
        },
        {
          "name": "DELETE - Elimina cliente di test",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/clienti/{{createdClienteId}}" }
        },
        {
          "name": "DELETE - Elimina concessionario di test",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/concessionari/{{createdConcessionarioId}}" }
        },
        {
          "name": "DELETE - Elimina casa madre di test",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/case-madri/{{createdCasaMadreId}}" }
        }
      ]
    },
    {
      "name": "Query Name Convention",
      "item": [

        { "name": "Cliente - cognome esatto", "request": { "method": "GET", "url": "{{baseUrl}}/api/clienti/query/cognome?cognome=Rossi" } },
        { "name": "Cliente - email", "request": { "method": "GET", "url": "{{baseUrl}}/api/clienti/query/email?email=mario%40email.it" } },
        { "name": "Cliente - nome contiene", "request": { "method": "GET", "url": "{{baseUrl}}/api/clienti/query/nome-contiene?sequenza=ari" } },
        { "name": "Cliente - cognome inizia con", "request": { "method": "GET", "url": "{{baseUrl}}/api/clienti/query/cognome-inizia?prefisso=Ros" } },
        { "name": "Cliente - registrati dopo", "request": { "method": "GET", "url": "{{baseUrl}}/api/clienti/query/registrati-dopo?data=2025-01-15" } },
        { "name": "Cliente - registrati tra date", "request": { "method": "GET", "url": "{{baseUrl}}/api/clienti/query/registrati-tra?inizio=2025-01-15&fine=2025-01-31" } },
        { "name": "Cliente - concessionario ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/clienti/query/concessionario/{{concessionarioId}}" } },
        { "name": "Cliente - nome e cognome", "request": { "method": "GET", "url": "{{baseUrl}}/api/clienti/query/nome-cognome?nome=Mario&cognome=Rossi" } },
        { "name": "Concessionario - città", "request": { "method": "GET", "url": "{{baseUrl}}/api/concessionari/query/citta?citta=Roma" } },
        { "name": "Concessionario - nome contiene", "request": { "method": "GET", "url": "{{baseUrl}}/api/concessionari/query/nome-contiene?sequenza=Auto" } },
        { "name": "Concessionario - fatturato superiore", "request": { "method": "GET", "url": "{{baseUrl}}/api/concessionari/query/fatturato-superiore?importo=500000" } },
        { "name": "Concessionario - fatturato tra valori", "request": { "method": "GET", "url": "{{baseUrl}}/api/concessionari/fatturato?min=100000&max=900000" } },
        { "name": "Concessionario - Casa Madre ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/concessionari/query/casa-madre-id/{{casaMadreId}}" } },
        { "name": "Concessionario - Casa Madre ragione sociale", "request": { "method": "GET", "url": "{{baseUrl}}/api/concessionari/query/casa-madre-ragione-sociale?ragioneSociale=Auto%20Italia%20Group" } },
        { "name": "Concessionario - città e fatturato", "request": { "method": "GET", "url": "{{baseUrl}}/api/concessionari/query/citta-fatturato-superiore?citta=Roma&importo=100000" } },
        { "name": "Casa Madre - ragione sociale", "request": { "method": "GET", "url": "{{baseUrl}}/api/case-madri/query/ragione-sociale?ragioneSociale=Auto%20Italia%20Group" } },
        { "name": "Casa Madre - paese", "request": { "method": "GET", "url": "{{baseUrl}}/api/case-madri/query/paese?paese=Italia" } },
        { "name": "Casa Madre - paese senza case", "request": { "method": "GET", "url": "{{baseUrl}}/api/case-madri/query/paese-ignore-case?paese=italia" } },
        { "name": "Casa Madre - anno fondazione", "request": { "method": "GET", "url": "{{baseUrl}}/api/case-madri/query/fondate-prima?anno=2000" } },
        { "name": "Casa Madre - fatturato superiore", "request": { "method": "GET", "url": "{{baseUrl}}/api/case-madri/query/fatturato-superiore?importo=4000000" } },
        { "name": "Casa Madre - ragione sociale contiene", "request": { "method": "GET", "url": "{{baseUrl}}/api/case-madri/query/ragione-sociale-contiene?sequenza=Auto" } }
      ]
    },
    {
      "name": "Query JPQL",
